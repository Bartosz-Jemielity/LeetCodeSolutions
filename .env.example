# Copy this file to .env and paste your values (.env is gitignored - it never reaches GitHub).
# Where to get them: log in to leetcode.com -> F12 -> Application -> Cookies -> https://leetcode.com

# "LEETCODE_SESSION" cookie (a long string, usually starting with eyJ...)
LEETCODE_SESSION=paste_your_LEETCODE_SESSION_value_here


# 1 = walk the entire submission history (instead of only new submissions)
LEETCODE_FULL_SYNC=0
